LLM_MODE=mock
OPENAI_MODEL=gpt-4o-mini
# Speech-to-text for POST /chat/voice (OpenAI API only; no local Whisper).
WHISPER_MODEL=whisper-1
APP_NAME=DEUS Bank Support API
